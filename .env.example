# ==============================================================================
# LEAKTRACE CENTRAL BACKEND CONFIGURATION
# SIH 2026 - Problem Statement #26237 | Ministry of Defence (WESEE)
# ==============================================================================

# 1. DATABASE CONFIGURATION
# For Connected Cloud Mode (Render + Supabase):
# Provide the direct or pooled PostgreSQL connection string from Supabase.
# Example: postgresql://postgres.abcdef:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# For Offline / Air-Gapped Mode:
# Leave DATABASE_URL commented out or empty. LeakTrace automatically falls back to local SQLite.
# LEAKTRACE_DB=leaktrace.db

# 2. SUPABASE PROTECTED STORAGE (OPTIONAL)
# When configured, protected AES-256 encrypted PDFs are stored in private Supabase Storage buckets.
# If omitted, protected PDFs are safely persisted inside PostgreSQL BYTEA storage automatically.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-secret-key
SUPABASE_STORAGE_BUCKET=leaktrace-documents

# 3. PUBLIC BACKEND URL
# Set this to your live Render public HTTPS URL.
# Desktop Electron clients will point to this address to communicate across laptops.
LEAKTRACE_API_URL=https://leaktrace-backend.onrender.com

# 4. SERVER BIND CONFIGURATION
HOST=0.0.0.0
PORT=8000
DEBUG=false

# 5. INITIAL SEEDING (OPTIONAL)
# Set to 'true' if you want the backend to automatically pre-seed the primary administrator on first launch.
LEAKTRACE_SEED_DEFAULTS=false
